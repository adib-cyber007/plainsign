# Optional Sepolia JSON-RPC override. Defaults to the keyless public RPC in the app.
VITE_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# Optional Alchemy key for Phase 6 asset-change simulation.
VITE_ALCHEMY_KEY=

# Optional LLM provider key for the stretch explanation feature.
VITE_LLM_KEY=

# Phase 5 deployer private key. Never commit a real value.
DEPLOYER_PRIVATE_KEY=

# Phase 4/5 demo attacker wallet address.
ATTACKER_ADDRESS=

# Phase 4/5 demo victim wallet address.
VICTIM_ADDRESS=

# Demo dApp chain: 31337 for Hardhat or 11155111 for Sepolia.
VITE_DEMO_CHAIN=31337
